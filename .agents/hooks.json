{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "writeGate": {
              "version": 1,
              "protocolVersion": 2,
              "workerProtocol": 1,
              "path": ".normproof/write-gate/cli.mjs",
              "sha256": "19db6c39a4305216ec9497ad926ba1e5f57636f162a3fd57d6e6ddda0ac2b185",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "completionGate": {
              "version": 1,
              "path": ".normproof/completion-gate/cli.mjs",
              "sha256": "1b0e6ab5b7d00c05b8e5abb88cb777c3330dde75628340d0d29bb4916efa2cf4",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 20000
          }
        ]
      }
    ]
  }
}
