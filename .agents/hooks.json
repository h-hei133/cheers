{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "writeGate": {
              "version": 1,
              "protocolVersion": 2,
              "workerProtocol": 1,
              "path": ".normproof/write-gate/cli.mjs",
              "sha256": "f2cc9adb1f7e3b973db085d739dd39a604206a7b000c007ded63c17adbf08ea6",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "completionGate": {
              "version": 1,
              "path": ".normproof/completion-gate/cli.mjs",
              "sha256": "4d5d4e565e279376a03119a3902a3316deaf71932811f738fcfcdf983b9a2a8b",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 20000
          }
        ]
      }
    ]
  }
}
