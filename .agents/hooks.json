{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "writeGate": {
              "version": 1,
              "protocolVersion": 2,
              "workerProtocol": 1,
              "path": ".normproof/write-gate/cli.mjs",
              "sha256": "cf97c097150477d653dba9c71c91e2f80c18d2a4a0e34c4d9e50bdaeb3e81bed",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "completionGate": {
              "version": 1,
              "path": ".normproof/completion-gate/cli.mjs",
              "sha256": "3ec59777793f7b664face5e11f89ca29d86f92f2dd4d49bdaff692574f3dadbd",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 20000
          }
        ]
      }
    ]
  }
}
