{
  "name": "@cheers/ts-shell",
  "version": "0.1.0",
  "description": "TypeScript CLI shell and orchestration layer",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/entrypoints/cli.tsx",
    "start": "tsx src/entrypoints/cli.tsx",
    "test": "vitest run",
    "test:gate:golden-main-path": "vitest run src/cli-baseline.test.ts -t \"GOLDEN_MAIN_PATH\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "grok-mermaid": "^0.2.3",
    "highlight.js": "11.12.0",
    "ignore": "^7.0.9",
    "picomatch": "^4.0.7",
    "playwright-core": "^1.60.0",
    "typescript": "^5.2.0",
    "undici": "^7.18.2",
    "which": "4.0.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@types/which": "3.0.4",
    "tsx": "^4.0.0",
    "vitest": "^0.34.0"
  }
}
