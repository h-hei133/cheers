{
  "name": "private-coding-agents",
  "version": "0.1.0",
  "description": "Maintainable three-layer workspace: TypeScript shell, Rust core, Python eval",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit:recent": "node scripts/show-audit.mjs",
    "workflow:status": "node scripts/workflow-status.mjs",
    "build": "npm run build --workspaces",
    "build:ts": "npm run build -w packages/ts-shell",
    "build:rust": "npm run build -w packages/rust-core",
    "test": "npm run test:gate:golden-main-path && node scripts/test-all-stacks.mjs",
    "test:ts": "npm run test -w packages/ts-shell",
    "test:gate:golden-main-path": "npm run test:gate:golden-main-path -w packages/ts-shell",
    "test:rust": "npm run test -w packages/rust-core",
    "test:python": "D:\\conda-envs\\coding_agents\\python.exe scripts/run-python-tests.py",
    "test:all": "npm run test:gate:golden-main-path && node scripts/test-all-stacks.mjs",
    "dev": "npm run dev -w packages/ts-shell",
    "start": "npm run start -w packages/ts-shell",
    "validate": "node scripts/validate-structure.mjs",
    "worktree:create": "node scripts/worktree-create.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
