{
  "name": "@cheers/ts-shell",
  "version": "0.1.0",
  "description": "TypeScript CLI shell and orchestration layer",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core/agent": {
      "types": "./dist/types/core/agent/loop.d.ts",
      "import": "./dist/core/agent/loop.js",
      "default": "./dist/core/agent/loop.js"
    },
    "./core/models": {
      "types": "./dist/types/core/models/catalog.d.ts",
      "import": "./dist/core/models/catalog.js",
      "default": "./dist/core/models/catalog.js"
    },
    "./core/models/virtual": {
      "types": "./dist/types/core/models/virtualModels.d.ts",
      "import": "./dist/core/models/virtualModels.js",
      "default": "./dist/core/models/virtualModels.js"
    },
    "./core/tools": {
      "types": "./dist/types/core/tools/registry.d.ts",
      "import": "./dist/core/tools/registry.js",
      "default": "./dist/core/tools/registry.js"
    },
    "./core/tools/codemode": {
      "types": "./dist/types/core/tools/codemode/tool.d.ts",
      "import": "./dist/core/tools/codemode/tool.js",
      "default": "./dist/core/tools/codemode/tool.js"
    },
    "./provider/endpoints": {
      "types": "./dist/types/provider/endpoints/index.d.ts",
      "import": "./dist/provider/endpoints/index.js",
      "default": "./dist/provider/endpoints/index.js"
    },
    "./rpc": {
      "types": "./dist/types/cli/rpc/rpcServer.d.ts",
      "import": "./dist/cli/rpc/rpcServer.js",
      "default": "./dist/cli/rpc/rpcServer.js"
    },
    "./extensions": {
      "types": "./dist/types/extensions/service.d.ts",
      "import": "./dist/extensions/service.js",
      "default": "./dist/extensions/service.js"
    },
    "./session/export": {
      "types": "./dist/types/session/export/html.d.ts",
      "import": "./dist/session/export/html.js",
      "default": "./dist/session/export/html.js"
    },
    "./browser": {
      "types": "./dist/types/browser/playwrightRuntime.d.ts",
      "import": "./dist/browser/playwrightRuntime.js",
      "default": "./dist/browser/playwrightRuntime.js"
    },
    "./desktop": {
      "types": "./dist/types/desktop/tool.d.ts",
      "import": "./dist/desktop/tool.js",
      "default": "./dist/desktop/tool.js"
    },
    "./media": {
      "types": "./dist/types/runtime/execution/media/index.d.ts",
      "import": "./dist/runtime/execution/media/index.js",
      "default": "./dist/runtime/execution/media/index.js"
    },
    "./collaboration": {
      "types": "./dist/types/cli/collaboration/control.d.ts",
      "import": "./dist/cli/collaboration/control.js",
      "default": "./dist/cli/collaboration/control.js"
    },
    "./planning": {
      "types": "./dist/types/cli/runtime/planning.d.ts",
      "import": "./dist/cli/runtime/planning.js",
      "default": "./dist/cli/runtime/planning.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs",
    "dev": "tsx watch src/entrypoints/cli.tsx",
    "start": "tsx src/entrypoints/cli.tsx",
    "test": "vitest run",
    "test:gate:golden-main-path": "vitest run src/cli-baseline.test.ts -t \"GOLDEN_MAIN_PATH\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-uri": "4.2.3",
    "gpt-tokenizer": "4.1.0",
    "grok-mermaid": "^0.2.3",
    "highlight.js": "11.12.0",
    "ignore": "^7.0.9",
    "jsonc-parser": "3.3.1",
    "json-schema-library": "11.6.16",
    "picomatch": "^4.0.7",
    "playwright-core": "^1.60.0",
    "saxes": "6.0.0",
    "tar": "7.5.14",
    "typescript": "^5.2.0",
    "undici": "6.29.1",
    "which": "4.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3",
    "@types/which": "3.0.4",
    "tsx": "^4.0.0",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "types": "./dist/types/index.d.ts"
}
