{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "writeGate": {
              "version": 1,
              "protocolVersion": 2,
              "workerProtocol": 1,
              "path": ".normproof/write-gate/cli.mjs",
              "sha256": "a9dc71e8e9cd9ce2b77e9d2b64539702fea32fd8b2444c31f092db27032b5600",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "completionGate": {
              "version": 1,
              "path": ".normproof/completion-gate/cli.mjs",
              "sha256": "eca24a7f3d3488715d8a78616f97a3f3538ceed1cb3f8f3d7a0bb3fc8d3cb7e3",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 20000
          }
        ]
      }
    ]
  }
}
