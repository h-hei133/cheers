{
  "id": "software-structure-v0",
  "version": "0",
  "name": "Software structure",
  "description": "Structural norms generated for this workspace. Every obligation names a path detected in it.",
  "obligationTemplates": [
    {
      "id": "source_graph_is_acyclic",
      "title": "No runtime dependency cycle among source modules",
      "severity": "blocking",
      "requiredWhen": {
        "kind": "always"
      },
      "requiredEvidence": [
        "source_module_graph"
      ],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "acyclic",
        "evidenceId": "source_module_graph"
      },
      "repair": "Remove a value dependency along the reported cycle. Use a type-only import where only types are needed."
    },
    {
      "id": "source_graph_has_no_unresolved_specifiers",
      "title": "Every module import resolves within the declared source graph",
      "severity": "blocking",
      "requiredWhen": {
        "kind": "always"
      },
      "requiredEvidence": [
        "source_module_graph"
      ],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "none",
        "evidenceId": "source_module_graph",
        "matches": "unresolved: */**"
      },
      "repair": "Use a declared package entry or an import that resolves to captured source."
    },
    {
      "id": "execution_does_not_reach_cli",
      "title": "Execution does not depend on the CLI",
      "severity": "advisory",
      "requiredWhen": {
        "kind": "always"
      },
      "requiredEvidence": [
        "source_module_graph"
      ],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "noDependency",
        "evidenceId": "source_module_graph",
        "from": "packages/ts-shell/src/runtime/execution/**",
        "to": "packages/ts-shell/src/cli/**",
        "reachable": true
      },
      "repair": "Inject the runtime implementation from the composition entry."
    },
    {
      "id": "domains_do_not_reach_shell",
      "title": "Domain packages do not depend on the shell",
      "severity": "blocking",
      "requiredWhen": {
        "kind": "always"
      },
      "requiredEvidence": [
        "source_module_graph"
      ],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "noDependency",
        "evidenceId": "source_module_graph",
        "from": "packages/**",
        "excludeFrom": [
          "packages/ts-shell/**"
        ],
        "to": "packages/ts-shell/**",
        "reachable": true
      },
      "repair": "Accept the required behavior through the domain interface and supply it from the shell."
    },
    {
      "id": "filenames_carry_no_phase_labels",
      "title": "Source filenames describe their responsibility",
      "severity": "blocking",
      "requiredWhen": { "kind": "always" },
      "requiredEvidence": ["source_filenames"],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "all",
        "operands": [
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-v2*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-v3*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-new*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-old*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-temp*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-tmp*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-copy*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-final*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-mvp*", "caseInsensitive": true },
          { "kind": "none", "evidenceId": "source_filenames", "matches": "**/*-phase*", "caseInsensitive": true }
        ]
      },
      "repair": "Choose a responsibility-based filename and update its imports."
    },
    {
      "id": "declared_functions_within_module_ceiling",
      "title": "No module declares more function-like names than the responsibility ceiling allows",
      "severity": "advisory",
      "requiredWhen": {
        "kind": "always"
      },
      "requiredEvidence": [
        "source_module_functions",
        "structure_baseline"
      ],
      "requiredAuthority": "A0",
      "expression": {
        "kind": "groupSizeUnder",
        "evidenceId": "source_module_functions",
        "ceiling": {
          "kind": "baseline",
          "evidenceId": "structure_baseline"
        },
        "onEmpty": "unsatisfied"
      },
      "repair": "Extract one responsibility from the module to satisfy its accepted ceiling."
    }
  ]
}
