node_modules/
packages/*/node_modules/

dist/
packages/*/dist/

# The one remaining .py dev script can still write bytecode if imported.
# pytest and ruff are gone with the Python workspace member, so their caches are not.
__pycache__/
*.py[cod]
*.corrupted.bak

# local scratch / replay artifacts
.tmp-*
tmp-*
packages/ts-shell/.tmp-debug-*/
packages/ts-shell/_cli_input.txt
status=*
.ts-shell/
Microsoft/

.DS_Store
Thumbs.db

rtk/
.omx/
.codex/*
!.codex/agents/
!.codex/agents/**
!.codex/skills/
!.codex/skills/**
.codex/skills/.system/**
!.codex/prompts/
!.codex/prompts/**

# NormProof judge output
.normproof/out/

# Project memory written by /memory save. The directory holds what a session
# recorded about this project, which is per-machine working state rather than
# repository content — the same reason .normproof/out/ and .omp/ are here.
# Subagent memories live in sibling directories and were never tracked.
.agents/memory/

# omp project settings (model overrides for subagents)
.omp/

# Throwaway probe scripts. A probe exists to answer one question about the real
# behavior and is deleted when it has; the convention is a `.probe_*.ts` name in
# the directory of the code it drives, so the pattern is anchored to that shape
# and never matches a fixture a test legitimately keeps.
**/.probe_*.ts

# A path built from an undefined variable, so the literal directory `undefined`
# appears. Seen twice: a committed rustup config, and local `.cheers/` session
# state from a test run. Never project content — a script that writes here has a
# bug, and this keeps its output out of a commit until the bug is found.
/undefined/
packages/ts-shell/undefined/

.claude/
.sisyphus/
.tmp/

# Local project settings and MCP definitions may reference personal services.
/.cheers/config.json
/.cheers/mcp.json
/.cheers.json
/.cheers.mcp.json
