{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "writeGate": {
              "version": 1,
              "protocolVersion": 2,
              "workerProtocol": 1,
              "path": ".normproof/write-gate/cli.mjs",
              "sha256": "e76dac23e7a890aa2075a342d8f1009ae1b25c7079e7003804a70935cc952e16",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "completionGate": {
              "version": 1,
              "path": ".normproof/completion-gate/cli.mjs",
              "sha256": "b99d6fe8ed6f0840df711e08a7e8716d750f853a83857061df3692325e30b76d",
              "nodeFloor": "20.3.0"
            },
            "timeoutMs": 20000
          }
        ]
      }
    ]
  }
}
