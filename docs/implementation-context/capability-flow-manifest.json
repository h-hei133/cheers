        "SessionManager/session boundary tests",
        "runMvp and result-contract when Agent Loop handoff changes"
      ]
    }
  },
  "validation": {
    "routeTiers": {
      "tier1DocsManifest": [
        "JSON parse check for capability-flow-manifest.json",
        "rtk git diff --check",
        "rtk git status --short --branch",
        "package file diff guard"
      ],
      "tier2SourceTouched": [
        "focused tests for touched module",
        "build when TypeScript source changes"
      ],
      "tier3TruthfulnessOrRuntimeTouched": [
        "result-contract",
        "runMvp/sessionRuntime/SessionManager gates when relevant",
        "package sweep only when escalation conditions are hit"
      ]
    },
    "defaultForThisPack": "tier1DocsManifest",
    "packageGuard": [
      "package.json",
      "package-lock.json",
      "packages/ts-shell/package.json"
    ]
  }
