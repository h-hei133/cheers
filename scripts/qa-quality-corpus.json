{
  "schemaVersion": "phase20-quality-corpus.v1",
  "version": "phase20-qa03-starter-v1",
  "qualifying": false,
  "minimumPairs": 5,
  "tasks": [
    {
      "id": "read-symbol",
      "stratum": "local-read",
      "prompt": "Read src/symbol.ts. Return only JSON with keys symbol and value. The symbol is target and its value is alpha.",
      "fixture": [
        {
          "path": "src/symbol.ts",
          "content": "export const target = \"alpha\";\n"
        }
      ],
      "scorer": {
        "kind": "deterministic",
        "textIncludes": ["target", "alpha"],
        "jsonFields": ["symbol", "value"],
        "requiredTools": ["read"]
      }
    },
    {
      "id": "edit-single-file",
      "stratum": "local-edit",
      "prompt": "Change notes.txt so its complete content is status=ready followed by one newline. Do not modify any other file.",
      "fixture": [
        {
          "path": "notes.txt",
          "content": "status=old\n"
        }
      ],
      "scorer": {
        "kind": "deterministic",
        "files": [
          {
            "path": "notes.txt",
            "content": "status=ready\n"
          }
        ],
        "requiredTools": ["edit"]
      }
    },
    {
      "id": "edit-two-files",
      "stratum": "multi-file-edit",
      "prompt": "Set alpha.txt to alpha and beta.txt to beta. Keep exactly one newline at the end of each file.",
      "fixture": [
        {
          "path": "alpha.txt",
          "content": "old-alpha\n"
        },
        {
          "path": "beta.txt",
          "content": "old-beta\n"
        }
      ],
      "scorer": {
        "kind": "deterministic",
        "files": [
          {
            "path": "alpha.txt",
            "content": "alpha\n"
          },
          {
            "path": "beta.txt",
            "content": "beta\n"
          }
        ],
        "requiredTools": ["edit"]
      }
    },
    {
      "id": "search-large-tree",
      "stratum": "repository-search",
      "prompt": "Find the unique marker NEEDLE-7 in the workspace. Return a JSON object with path and marker keys.",
      "fixture": [
        {
          "path": "data/00.txt",
          "content": "noise\n"
        },
        {
          "path": "data/01.txt",
          "content": "noise\n"
        },
        {
          "path": "data/02.txt",
          "content": "NEEDLE-7\n"
        }
      ],
      "scorer": {
        "kind": "deterministic",
        "textIncludes": ["NEEDLE-7", "data/02.txt"],
        "jsonFields": ["path", "marker"],
        "requiredTools": ["grep"]
      }
    },
    {
      "id": "summary-facts",
      "stratum": "summary-quality",
      "prompt": "Read context.md and return a concise summary with exactly two labeled lines: RISK: followed by the stated risk, and DECISION: followed by the stated decision. Do not add other claims.",
      "fixture": [
        {
          "path": "context.md",
          "content": "Risk: the cache may be cold on the first request.\nDecision: keep the fallback path enabled.\n"
        }
      ],
      "scorer": {
        "kind": "blind-human",
        "rubric": "The summary must name the cold-cache risk, preserve the fallback decision, add no unsupported claims, and use the requested labels."
      }
    },
    {
      "id": "render-markdown",
      "stratum": "render-quality",
      "prompt": "Return a short Markdown example containing one two-column table row, one inline math expression for x squared, and one fenced code block. Do not execute the code.",
      "fixture": [],
      "scorer": {
        "kind": "deterministic",
        "textIncludes": ["|", "$x^2$", "```"],
        "textExcludes": ["execute"]
      }
    }
  ]
}
