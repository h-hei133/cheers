{
  "name": "private-coding-agents",
  "version": "0.1.0",
  "description": "Maintainable three-layer workspace: TypeScript shell, Rust core, Python eval",
  "private": true,
  "type": "module",
  "bin": {
    "private-agents": "./dist/cli.js",
    "cheer": "./dist/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "audit:recent": "node scripts/show-audit.mjs",
    "workflow:status": "node scripts/workflow-status.mjs",
    "build": "npm run build --workspaces",
    "build:ts": "npm run build -w packages/ts-shell && node scripts/build-cli-bin.mjs",
    "build:cli": "npm run build:ts",
    "build:rust": "npm run build -w packages/rust-core",
    "test": "npm run test:gate:golden-main-path && node scripts/test-all-stacks.mjs",
    "test:ts": "npm run test -w packages/ts-shell",
    "test:gate:golden-main-path": "npm run test:gate:golden-main-path -w packages/ts-shell",
    "test:rust": "npm run test -w packages/rust-core",
    "test:python": "D:\\conda-envs\\coding_agents\\python.exe scripts/run-python-tests.py",
    "test:all": "npm run test:gate:golden-main-path && node scripts/test-all-stacks.mjs",
    "dev": "npm run dev -w packages/ts-shell --",
    "start": "npm run start -w packages/ts-shell --",
    "start:live:interactive": "node scripts/live-interactive-runner.mjs",
    "validate": "node scripts/validate-structure.mjs",
    "worktree:create": "node scripts/worktree-create.mjs",
    "test:daily": "node scripts/daily-regression.mjs",
    "test:broader": "node scripts/broader-regression.mjs --tier full",
    "test:broader:p0": "node scripts/broader-regression.mjs --tier p0",
    "test:broader:p1": "node scripts/broader-regression.mjs --tier p1",
    "test:artifacts:validate": "node scripts/validate-broader-artifacts.mjs",
    "test:comprehensive": "node scripts/comprehensive-regression.mjs --mode daily",
    "test:release-gate": "node scripts/comprehensive-regression.mjs --mode release",
    "verify:permission-memory": "node scripts/verify-permission-memory.mjs hard",
    "verify:permission-memory:real": "node scripts/verify-permission-memory.mjs real",
    "verify:permission-memory:all": "node scripts/verify-permission-memory.mjs all",
    "verify:doctor": "node scripts/verify-doctor-environment.mjs",
    "verify:rust-execution": "node scripts/verify-rust-execution.mjs hard",
    "verify:rust-execution:env": "node scripts/verify-rust-execution.mjs env",
    "verify:session-lifecycle": "node scripts/verify-session-lifecycle.mjs",
    "verify:query-orchestration": "node scripts/verify-query-orchestration.mjs",
    "verify:cli-entry": "node scripts/verify-cli-entry.mjs",
    "verify:mcp-routing": "node scripts/verify-mcp-routing.mjs",
    "verify:mcp:local-execution": "node scripts/verify-mcp-local-execution.mjs",
    "verify:mcp:error-taxonomy": "node scripts/verify-mcp-error-taxonomy.mjs",
    "verify:result-contract": "node scripts/verify-result-contract.mjs",
    "verify:route205-repair-proof-chain": "node scripts/verify-route205-repair-proof-chain.mjs",
    "verify:route206-controlled-multifile-proof-chain": "node scripts/verify-route206-controlled-multifile-proof-chain.mjs",
    "verify:route208-product-path-benchmark": "tsx scripts/route208-product-path-benchmark.ts",
    "verify:route209-planning-proof-handoff-benchmark": "tsx scripts/route209-planning-proof-handoff-benchmark.ts",
    "demo:route207": "tsx scripts/route207-demo.ts",
    "verify:edit-capability-closeout": "node scripts/verify-edit-capability-closeout.mjs",
    "verify:browser-txn-gate": "node scripts/verify-browser-txn-gate.mjs",
    "verify:workspace-safety": "node scripts/verify-workspace-safety.mjs",
    "verify:evidence-artifacts": "node scripts/verify-evidence-artifacts.mjs",
    "evidence:inspect": "node scripts/inspect-evidence-artifact.mjs",
    "verify:evidence-inspector": "node scripts/verify-evidence-inspector.mjs",
    "failure:handoff": "node scripts/triage-release-failure.mjs",
    "verify:failure-handoff": "node scripts/verify-failure-handoff.mjs",
    "verify:real-user-capabilities": "node scripts/verify-real-user-capabilities.mjs",
    "verify:real-user-capabilities:mvp": "node scripts/verify-real-user-capabilities.mjs --tier=mvp",
    "verify:real-user-capabilities:candidate": "node scripts/verify-real-user-capabilities.mjs --tier=candidate",
    "verify:real-user-capabilities:candidates": "node scripts/verify-real-user-capabilities.mjs --tier=candidate",
    "verify:real-user-capabilities:candidate-mutation": "node scripts/verify-real-user-capabilities.mjs --suite=candidate-mutation",
    "verify:real-user-capabilities:candidate-mutation:real": "node scripts/verify-real-user-capabilities.mjs --suite=candidate-mutation --include-real",
    "verify:real-user-capabilities:two-file-cli-evidence": "node scripts/verify-real-user-capabilities.mjs --route03-two-file-cli-path-evidence",
    "verify:real-user-capabilities:unsupported-patch-e2e": "node scripts/verify-real-user-capabilities.mjs --route08-unsupported-patch-e2e",
    "verify:real-user-capabilities:three-file-guarded-write": "node scripts/verify-three-file-guarded-write.mjs",
    "verify:real-user-capabilities:single-file-move-evidence": "node scripts/verify-single-file-move-evidence.mjs",
    "verify:real-user-capabilities:single-file-delete-evidence": "node scripts/verify-single-file-delete-evidence.mjs",
    "verify:real-user-capabilities:mixed-operation-evidence": "node scripts/verify-mixed-operation-evidence.mjs",
    "verify:real-user-capabilities:three-file-planning-no-write": "node scripts/verify-three-file-planning-no-write.mjs",
    "verify:real-user-capabilities:planned-files-continuity": "node scripts/verify-planned-files-continuity.mjs",
    "verify:mutation-continuity:compact": "npm run test -w packages/ts-shell -- src/session/mutationCompactContinuity.test.ts",
    "verify:mutation-recovery:followup": "npm run test -w packages/ts-shell -- src/core/shell/continueShellActionRuntime.test.ts -t \"renders partial mutation recovery details before a stopped-session follow-up prompt\"",
    "verify:real-user-capabilities:real-single-file": "node scripts/verify-real-user-capabilities.mjs --case=real-selected-workspace-single-file-update",
    "verify:real-user-capabilities:real-create": "node scripts/verify-real-user-capabilities.mjs --case=real-selected-workspace-single-file-create",
    "verify:real-user-capabilities:real-two-file": "node scripts/verify-real-user-capabilities.mjs --case=real-selected-workspace-two-file-update",
    "verify:real-user-capabilities:release": "node scripts/verify-real-user-capabilities.mjs --tier=release",
    "verify:real-user-capabilities:backlog": "node scripts/verify-real-user-capabilities.mjs --tier=backlog",
    "verify:real-user-capabilities:all": "node scripts/verify-real-user-capabilities.mjs --tier=all",
    "verify:provider-readiness": "node scripts/verify-provider-readiness.mjs",
    "verify:provider-baseline": "node scripts/verify-provider-readiness.mjs --baseline-smoke",
    "verify:provider-readiness:real": "node scripts/verify-real-provider-readiness-smoke.mjs",
    "verify:lightweight-chat:real": "node scripts/real-provider-lightweight-chat-smoke.mjs",
    "verify:release:smoke": "node scripts/verify-release-smoke.mjs",
    "verify:release:core": "node scripts/verify-release-core.mjs",
    "verify:release:deterministic": "node scripts/verify-release-deterministic.mjs",
    "verify:release:real": "node scripts/verify-release-real.mjs",
    "test:delta:contracts": "node scripts/delta-regression.mjs --suite contracts",
    "test:delta:xlayer": "node scripts/delta-regression.mjs --suite xlayer",
    "test:delta:faults": "node scripts/delta-regression.mjs --suite faults",
    "test:delta:concurrency": "node scripts/delta-regression.mjs --suite concurrency",
    "test:delta:full": "node scripts/delta-regression.mjs --suite full",
    "test:delta:nightly": "node scripts/delta-nightly.mjs --duration-minutes 45",
    "test:delta:release": "cmd /d /s /c \"npm run test:delta:full && npm run test:delta:full && node scripts/delta-nightly.mjs --duration-minutes 1\"",
    "test:coverage:real-shapes": "node scripts/real-shape-coverage.mjs",
    "verify:session-durability:long": "node scripts/verify-session-durability-long.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
