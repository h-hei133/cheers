new file mode 100644
index 00000000..69e12431
--- /dev/null
+++ b/packages/ts-shell/src/observability/usage/presence.test.ts
@@ -0,0 +1,178 @@
+import { afterEach, describe, expect, it } from 'vitest';
+import type { ModelCostRates } from '../../core/models/catalog.js';
+import { costModel } from '../../core/commands/cost/model.js';
+import { usageFromProvider } from '../../provider/response/usage.js';
+import type { ProviderUsage } from '../../turn/completion.js';
+import { detectLatestCacheMiss, findCacheWaste, formatCacheMissNotice, summarizeCacheUsage, turnCacheMissNotice } from '../cacheWaste.js';
+import { getSessionUsage, markContextUnknown, persistSessionUsage, recordSessionUsage, resetSessionUsage, restoreSessionUsage, totalTokens } from '../usageTelemetry.js';
+import { attributedBucketKey, captureUsageAttribution } from './identity.js';
+import type { SessionUsageSnapshot, UsageAttribution, UsageHistoryEntry } from './model.js';
+import { decodeUsageHistory } from './snapshot.js';
+
+const A = 'cache-presence-a', B = 'cache-presence-b';
+const rates: ModelCostRates = { promptPerMTok: 1, completionPerMTok: 2, cacheReadPerMTok: 0.1, cacheWritePerMTok: 1.25 };
+const readRates: ModelCostRates = { promptPerMTok: 1, completionPerMTok: 2, cacheReadPerMTok: 0.1 };
+const firstHit: ProviderUsage = { prompt_tokens: 10_000, completion_tokens: 1, prompt_tokens_details: { cached_tokens: 8_000 } };
+const capture = (prices = rates) => captureUsageAttribution({ provider: 'p', model: 'org/model', baseUrl: 'https://relay.invalid/v1', rates: prices });
+
+afterEach(() => { resetSessionUsage(A); resetSessionUsage(B); });
+
+function recordRaw(usage: ProviderUsage, attribution: UsageAttribution = capture(), session = A): void {
+  recordSessionUsage(session, {
+    ...usageFromProvider(usage), attribution,
+    promptIdentity: { provider: attribution.provider, model: attribution.model,
+      endpoint: 'openai-compatible', endpointId: attribution.endpointId },
+  });
+}
+
+function reopenedHistory(): UsageHistoryEntry[] {
+  let saved: SessionUsageSnapshot | undefined;
+  persistSessionUsage(A, undefined, next => { saved = next; });
+  restoreSessionUsage(B, JSON.parse(JSON.stringify(saved)));
+  return getSessionUsage(B).recentRequests;
+}
+
+function expectNoMiss(history: readonly UsageHistoryEntry[], prices = rates): void {
+  expect(findCacheWaste(history, () => prices).misses).toEqual([]);
+  expect(detectLatestCacheMiss(history, () => prices)).toBeUndefined();
+  expect(turnCacheMissNotice(history, () => prices)).toBeUndefined();
+}
+
+describe('provider cache accounting presence', () => {
+  it('keeps two prompt-only responses unknown without fabricating a cache miss or hit rate', () => {
+    recordRaw({ prompt_tokens: 10_000, completion_tokens: 1 });
+    recordRaw({ prompt_tokens: 12_000, completion_tokens: 1 });
+    const telemetry = getSessionUsage(A);
+    expect(telemetry.recentRequests.map(entry => entry.kind)).toEqual(['request', 'request']);
+    expect(telemetry.recentRequests.map(entry => entry.promptTokens)).toEqual([10_000, 12_000]);
+    expect(totalTokens(telemetry)).toBe(22_002);
+    expect(summarizeCacheUsage(telemetry.recentRequests)).toEqual({
+      promptTokens: 0, cacheReadTokens: 0, hitRate: undefined, requestCount: 0,
+    });
+    expectNoMiss(telemetry.recentRequests);
+    const reopened = reopenedHistory();
+    expect(summarizeCacheUsage(reopened).hitRate).toBeUndefined();
+    expectNoMiss(reopened);
+  });
+
+  it.each([
+    { name: 'omitted cache fields', usage: { prompt_tokens: 12_000, completion_tokens: 1 } },
+    { name: 'empty cache details', usage: { prompt_tokens: 12_000, completion_tokens: 1, prompt_tokens_details: {} } },
+    { name: 'only a cache-write category', usage: { prompt_tokens: 0, completion_tokens: 1, cache_creation_input_tokens: 12_000 } },
+  ] satisfies { name: string; usage: ProviderUsage }[])('excludes $name after a reported hit instead of inheriting a zero read', ({ usage }) => {
+    recordRaw(firstHit);
+    recordRaw(usage);
+    const expected = { promptTokens: 10_000, cacheReadTokens: 8_000, hitRate: 80, requestCount: 1 };
+    const history = getSessionUsage(A).recentRequests;
+    expect(history.map(entry => entry.promptTokens)).toEqual([10_000, 12_000]);
+    expect(summarizeCacheUsage(history)).toEqual(expected);
+    expectNoMiss(history);
+    const reopened = reopenedHistory();
+    expect(summarizeCacheUsage(reopened)).toEqual(expected);
+    expectNoMiss(reopened);
+  });
+
+  it('retains an explicit zero cache-read category as measured after a hit and after reopen', () => {
+    recordRaw(firstHit);
+    recordRaw({ prompt_tokens: 12_000, completion_tokens: 1, prompt_tokens_details: { cached_tokens: 0 } });
+    for (const history of [getSessionUsage(A).recentRequests, reopenedHistory()]) {
+      const summary = summarizeCacheUsage(history);
+      expect(summary).toMatchObject({ promptTokens: 22_000, cacheReadTokens: 8_000, requestCount: 2 });
+      expect(summary.hitRate).toBeCloseTo(8_000 / 22_000 * 100);
+      const miss = detectLatestCacheMiss(history, () => rates);
+      expect(miss?.missedTokens).toBe(10_000);
+      expect(miss?.missedCost).toBeCloseTo(0.009, 8);
+      expect(findCacheWaste(history, () => rates).misses).toEqual([miss]);
+    }
+  });
+
+  it.each(['context-reset', 'usage-gap'] as const)('does not compare an explicit measured zero across a %s', kind => {
+    recordRaw(firstHit);
+    markContextUnknown(A, kind);
+    recordRaw({ prompt_tokens: 12_000, completion_tokens: 1, prompt_tokens_details: { cached_tokens: 0 } });
+    const history = getSessionUsage(A).recentRequests;
+    expect(history.map(entry => entry.kind)).toEqual(['request', kind, 'request']);
+    expect(summarizeCacheUsage(history).requestCount).toBe(2);
+    expectNoMiss(history);
+    expectNoMiss(reopenedHistory());
+  });
+
+  it('treats old sticky-only zero entries as unknown while preserving positive legacy cache-read evidence', () => {
+    const attribution = capture();
+    const bucketKey = attributedBucketKey(attribution);
+    // Authored in the old schema: reportedCache describes earlier activity,
+    // and no per-request field-presence evidence was persisted for either row.
+    const history: UsageHistoryEntry[] = [
+      { promptTokens: 10_000, completionTokens: 1, cacheReadTokens: 8_000, cacheWriteTokens: 0,
+        bucketKey, attribution, timestamp: 1, reportedCache: true, kind: 'request' },
+      { promptTokens: 12_000, completionTokens: 1, cacheReadTokens: 0, cacheWriteTokens: 0,
+        bucketKey, attribution, timestamp: 2, reportedCache: true, kind: 'request' },
+    ];
+    const snapshot: SessionUsageSnapshot = {
+      schemaVersion: 2, byModel: { [bucketKey]: { attribution, promptTokens: 14_000, completionTokens: 2,
+        totalTokens: 22_002, cacheReadTokens: 8_000, cacheWriteTokens: 0, turnsCount: 2 } },
+      recentRequests: history, turnsCount: 2, toolCallsCount: 0, lastBucketKey: bucketKey, lastUpdated: 2,
+    };
+    restoreSessionUsage(B, JSON.parse(JSON.stringify(snapshot)));
+    expect(totalTokens(getSessionUsage(B))).toBe(22_002);
+    for (const decoded of [decodeUsageHistory(history), getSessionUsage(B).recentRequests]) {
+      expect(summarizeCacheUsage(decoded)).toEqual({ promptTokens: 10_000, cacheReadTokens: 8_000, hitRate: 80, requestCount: 1 });
+      expectNoMiss(decoded);
+    }
+  });
+});
+
+describe('estimated cache miss cost from observed paid categories', () => {
+  it.each([
+    { name: 'all cache-write input', input: 0, write: 10_000, extra: 0.0115 },
+    { name: 'mixed ordinary and cache-write input', input: 2_000, write: 8_000, extra: 0.011 },
+  ])('includes the write premium for $name', ({ input, write, extra }) => {
+    recordRaw(firstHit);
+    recordRaw({ prompt_tokens: input, completion_tokens: 1, cache_read_input_tokens: 0, cache_creation_input_tokens: write });
+    for (const history of [getSessionUsage(A).recentRequests, reopenedHistory()]) {
+      expect(history.at(-1)?.promptTokens).toBe(10_000);
+      const result = findCacheWaste(history, () => rates);
+      expect(result.misses).toHaveLength(1);
+      expect(result.misses[0]?.missedTokens).toBe(10_000);
+      expect(result.misses[0]?.missedCost).toBeCloseTo(extra, 8);
+      expect(result.totals.missedCost).toBeCloseTo(extra, 8);
+      expect(detectLatestCacheMiss(history, () => rates)?.missedCost).toBeCloseTo(extra, 8);
+    }
+  });
+
+  it('withholds a dollar miss when an observed cache-write bucket had no captured rate', () => {
+    const attribution = capture(readRates);
+    recordRaw(firstHit, attribution);
+    recordRaw({ prompt_tokens: 0, completion_tokens: 1, cache_read_input_tokens: 0, cache_creation_input_tokens: 10_000 }, attribution);
+    expect(costModel(getSessionUsage(A), []).estimate.coverage).toBe('partial');
+    expectNoMiss(getSessionUsage(A).recentRequests);
+    expectNoMiss(reopenedHistory());
+  });
+
+  it('does not refill an absent captured write rate from a later catalogue publication', () => {
+    recordRaw(firstHit, capture());
+    recordRaw({ prompt_tokens: 0, completion_tokens: 1, cache_read_input_tokens: 0, cache_creation_input_tokens: 10_000 }, capture(readRates));
+    const catalogue = [{ id: 'p', models: [{ id: 'org/model', cost: rates }] }];
+    const report = costModel(getSessionUsage(A), catalogue as never);
+    expect(report.estimate.coverage).toBe('partial');
+    expect(report.buckets.every(bucket => bucket.rateBasis === 'captured')).toBe(true);
+    expect(report.buckets.find(bucket => bucket.cacheWriteTokens > 0)?.rates.cacheWritePerMTok).toBeNull();
+    expect(report.cache.waste.misses).toEqual([]);
+    expectNoMiss(getSessionUsage(A).recentRequests, rates);
+    const reopened = reopenedHistory();
+    expect(costModel(getSessionUsage(B), catalogue as never).cache.waste.misses).toEqual([]);
+    expectNoMiss(reopened, rates);
+  });
+
+  it('labels the turn-end notice as estimated overlap or potential extra cost', () => {
+    recordRaw(firstHit);
+    recordRaw({ prompt_tokens: 12_000, completion_tokens: 1, prompt_tokens_details: { cached_tokens: 0 } });
+    const history = getSessionUsage(A).recentRequests;
+    const miss = detectLatestCacheMiss(history, () => rates);
+    expect(miss).toBeDefined();
+    const notice = turnCacheMissNotice(history, () => rates);
+    expect(notice).toBe(formatCacheMissNotice(miss!));
+    expect(notice).toMatch(/\b(?:estimat(?:e|ed)|potential extra cost)\b/i);
+    expect(notice).not.toContain('prompt tokens re-billed');
+  });
+});
