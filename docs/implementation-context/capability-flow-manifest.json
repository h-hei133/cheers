  "contracts": {
    "CapabilityPlan": {
      "ownerModule": "agentLoop",
      "requiredFacts": [
        "intent classification",
        "owner capability",
        "policy and availability facts when known"
      ],
      "doNotEmit": [
        "write authorization by prompt implication",
        "provider credentials"
      ]
    },
    "PolicyDecision": {
      "ownerModule": "permissionPolicy",
      "requiredFacts": [
        "decision kind",
        "reason",
        "scope",
        "do-next when blocked"
      ],
      "doNotEmit": [
        "approval as write success",
        "hidden permission grants"
      ]
    },
    "WorkspaceTarget": {
      "ownerModule": "workspaceFileContext",
      "requiredFacts": [
        "workspace root",
        "target path or candidate set",
        "read/write authority distinction",
        "stale-read evidence when mutating"
      ],
      "doNotEmit": [
        "raw file content",
        "mutation authority from discovery candidates"
      ]
    },
    "RuntimeReceipt": {
      "ownerModule": "runtime",
      "requiredFacts": [
        "runtime kind",
        "availability",
        "policy",
        "execution",
        "result",
        "redaction status"
      ],
      "doNotEmit": [
        "raw DOM",
        "unbudgeted stdout/stderr",
        "secrets"
      ]
    },
    "CapabilityEvidence": {
      "ownerModule": "resultSurface",
      "requiredFacts": [
        "safe reason",
        "evidence markers",
        "do-next text when actionable",
        "redaction status when relevant"
      ],
      "doNotEmit": [
        "raw browser/page content",
        "raw file dumps",
        "provider config",
        "auth material"
      ]
    },
    "ResultHandoff": {
      "ownerModule": "resultSurface",
      "requiredFacts": [
        "terminal reason",
        "terminal classification",
        "stop reason when stopped/error",
        "coding result summary when present"
      ],
      "doNotEmit": [
        "false completed status",
        "vague stopped reason when actionable blocker exists"
      ]
    },
    "TerminalSummary": {
      "ownerModule": "resultSurface",
      "requiredFacts": [
        "completed/stopped/error truthfulness",
        "actionable blocker kind when known",
        "safe final output"
      ],
      "doNotEmit": [
        "raw DOM",
        "raw command dumps",
        "credentials"
      ]
    },
    "TranscriptEvent": {
      "ownerModule": "sessionContinue",
      "requiredFacts": [
        "event type",
        "safe payload",
        "stream order",
        "session id"
      ],
      "doNotEmit": [
        "schema drift",
        "unsafe replay evidence"
      ]
    },
    "ContinuationSeed": {
      "ownerModule": "sessionContinue",
      "requiredFacts": [
        "safe evidence",
        "target summary",
        "last terminal/coding result",
        "do-next when stopped"
      ],
      "doNotEmit": [
        "raw file dumps",
        "raw DOM",
        "secrets",
        "cookies",
        "auth headers"
      ]
    },
    "VerifierReport": {
      "ownerModule": "harnessEval",
      "requiredFacts": [
        "run id",
        "selected/skipped cases",
        "status",
        "exit code",
        "redaction checks",
        "residue classification"
      ],
      "doNotEmit": [
        "provider credentials",
        "provider config paths",
        "hidden skips"
      ]
    }
  },
  "recipes": {
    "addBoundedEditCapability": {
      "startModule": "editPatch",
      "requiredFacades": [
