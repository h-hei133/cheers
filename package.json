{
  "name": "cheers",
  "version": "0.1.0",
  "description": "Maintainable TypeScript coding agent: shell, session, orchestration and execution",
  "private": true,
  "type": "module",
  "bin": {
    "cheers": "./dist/cli.js"
  },
  "workspaces": [
    "packages/ts-shell"
  ],
  "scripts": {
